<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppTheme.Dialog.BackgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/layout_top_bar" layout="@layout/include_dialog_navigation_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_horizontal_default"
        android:layout_marginTop="@dimen/margin_vertical_large"
        android:orientation="vertical">

        <include android:id="@+id/field_name" layout="@layout/include_field_text_input" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_selected_sound"
            style="@style/AppTheme.TextAppearance.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_choose_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_default"
            android:text="@string/button_choose_sound" />
    </LinearLayout>
</LinearLayout>
